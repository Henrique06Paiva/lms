{
  "name": "educore-lms",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test:db": "tsx src/db/verify_triggers.ts",
    "test:core": "tsx src/core/verify_core.ts",
    "test:auth": "tsx src/modules/auth/verify_auth.ts",
    "test:courses": "tsx src/modules/courses/verify_courses.ts",
    "test:media": "tsx src/modules/media/verify_media.ts",
    "test:progress": "tsx src/modules/progress/verify_progress.ts",
    "test:certificates": "tsx src/modules/certificates/verify_certificates.ts",
    "test:frontend": "tsx src/core/verify_frontend.ts",
    "test": "tsx src/db/verify_triggers.ts && tsx src/core/verify_core.ts && tsx src/modules/auth/verify_auth.ts && tsx src/modules/courses/verify_courses.ts && tsx src/modules/media/verify_media.ts && tsx src/modules/progress/verify_progress.ts && tsx src/modules/certificates/verify_certificates.ts && tsx src/core/verify_frontend.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
